{
  "_comment": "DS2API 配置文件示例 - 复制为 config.json 使用",
  "_doc": "详细文档: https://github.com/CJackHwang/ds2api",
  "keys": [
    "your-api-key-1",
    "your-api-key-2"
  ],
  "api_keys": [
    {
      "key": "your-api-key-1",
      "name": "主 API Key",
      "remark": "给 OpenAI 客户端使用"
    },
    {
      "key": "your-api-key-2",
      "name": "备用 API Key",
      "remark": "压测或临时调试"
    }
  ],
  "accounts": [
    {
      "_comment": "邮箱登录方式；设备型号和 API 留空时自动分配并保存",
      "name": "主账号",
      "remark": "优先用于生产流量",
      "email": "example1@example.com",
      "password": "your-password-1",
      "device_model": "",
      "device_id": "",
      "rangers_id": "",
      "android_api_level": "",
      "pool_type": "default",
      "priority": 0
    },
    {
      "_comment": "邮箱登录方式 - 账号2",
      "name": "备用账号",
      "email": "example2@example.com",
      "password": "your-password-2"
    },
    {
      "_comment": "手机号登录方式（中国大陆）",
      "mobile": "12345678901",
      "password": "your-password-3"
    }
  ],
  "model_aliases": {
    "gpt-4o": "deepseek-v4.1-flash",
    "gpt-5.5": "deepseek-v4.1-flash",
    "gpt-5.3-codex": "deepseek-v4.1-flash",
    "o3": "deepseek-v4.1-flash"
  },
  "responses": {
    "store_ttl_seconds": 900,
    "max_entries": 256,
    "max_bytes_mib": 128,
    "max_caller_entries": 128
  },
  "tool_safety": {
    "allow_reasoning_prose": false
  },
  "thinking_injection": {
    "enabled": false,
    "prompt": ""
  },
  "embeddings": {
    "provider": "deterministic"
  },
  "admin": {
    "jwt_expire_hours": 24
  },
  "runtime": {
    "account_max_inflight": 2,
    "account_max_queue": 0,
    "global_max_inflight": 0,
    "token_refresh_interval_hours": 6,
    "account_daily_limit": {
      "enabled": false,
      "max_per_day": 0
    }
  },
  "auto_delete": {
    "mode": "none"
  },
  "input_file": {
    "enabled": false,
    "min_chars": 0
  },
  "bottom_format_injection": {
    "enabled": true,
    "prompt": ""
  },
  "elastic_pool": {
    "enabled": false,
    "global_count": 3
  },
  "keep_alive": {
    "enabled": false,
    "interval": "2-4",
    "record_history": false
  },
  "tts": {
    "enabled": true,
    "segment_chars": 160,
    "multi_account": true,
    "account_concurrency": true
  },
  "mihomo": {
    "enabled": false
  }
}
