{
  "client": {
    "name": "DeepSeek",
    "platform": "android",
    "version": "2.7.1",
    "android_api_level": "36",
    "locale": "zh_CN",
    "timezone_offset": "28800",
    "device_model": ""
  },
  "base_headers": {
    "Accept": "application/json",
    "Content-Type": "application/json",
    "accept-charset": "UTF-8",
    "x-client-bundle-id": "com.deepseek.chat",
    "Accept-Encoding": "gzip"
  },
  "skip_contains_patterns": [
    "quasi_status",
    "elapsed_secs",
    "token_usage",
    "pending_fragment",
    "conversation_mode",
    "fragments/-1/status",
    "fragments/-2/status",
    "fragments/-3/status"
  ],
  "skip_exact_paths": [
    "response/search_status"
  ]
}
